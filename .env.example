# Copy this file to .env for local development and replace the placeholder.
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=jobpilot
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DOCUMENT_STORAGE_PATH=var/documents
# Browser origin allowed for login and mutations; must match the Vite address.
AUTH_ALLOWED_ORIGIN=http://127.0.0.1:5173
# Use `none` only when the frontend and backend are on different sites; HTTPS is required.
AUTH_COOKIE_SAMESITE=strict
# Set to true only for local HTTP development with both servers on 127.0.0.1;
# it disables the Secure cookie flag. Leave false when serving over HTTPS.
AUTH_LOCAL_HTTP=false
